                radial-gradient(circle at 85% 60%, rgba(16, 185, 129, 0.08) 0%, transparent 40%),
                radial-gradient(circle at 50% 80%, rgba(197, 155, 39, 0.1) 0%, transparent 50%);
        }
    </style>
