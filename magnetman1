    <!-- Custom Aesthetics CSS -->
    <style>
        body {
            background-color: #0b0c10;
            color: #e2e8f0;
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
        }

        .font-cinzel {
            font-family: 'Cinzel', serif;
        }

        /* Metallic text gradient */
        .text-brass-gradient {
            background: linear-gradient(135deg, #f3e5ab 0%, #c59b27 50%, #8c6211 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .text-emerald-gradient {
            background: linear-gradient(135deg, #a7f3d0 0%, #10b981 50%, #047857 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .text-spooky-gradient {
            background: linear-gradient(135deg, #f87171 0%, #dc2626 50%, #7f1d1d 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Ornate borders and frames */
        .brass-border {
            border: 1px solid #c59b27;
            box-shadow: 0 0 10px rgba(197, 155, 39, 0.15);
        }

        .brass-border-glow {
            border: 1px solid #c59b27;
            box-shadow: 0 0 20px rgba(197, 155, 39, 0.3), inset 0 0 10px rgba(197, 155, 39, 0.1);
        }

        .gothic-box {
            background: rgba(26, 29, 38, 0.85);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(197, 155, 39, 0.25);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .gothic-box:hover {
            border-color: rgba(197, 155, 39, 0.6);
            transform: translateY(-3px);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.7), 0 0 15px rgba(197, 155, 39, 0.2);
        }

        /* Steampunk Cog Animation */
        @keyframes spin-slow {
            from { transform: rotate(0deg); }
            to { transform: rotate(360deg); }
        }
        @keyframes spin-reverse-slow {
            from { transform: rotate(360deg); }
            to { transform: rotate(0deg); }
        }

        .gear-spin {
            animation: spin-slow 25s linear infinite;
        }
        .gear-spin-rev {
            animation: spin-reverse-slow 20s linear infinite;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0b0c10;
        }
        ::-webkit-scrollbar-thumb {
            background: #4a3b10;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #c59b27;
        }

        /* Background atmospheric mesh */
